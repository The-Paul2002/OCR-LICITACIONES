# Entorno virtual: se reconstruye con PLAN_60MIN.md, no se versiona.
.venv/

# Pesos de modelos y caché de PaddleOCR/PaddleX
*.pdmodel
*.pdiparams
*.onnx
.paddleocr/
.paddlex/

# Salidas regenerables
data/processed/
data/outputs/
logs/

# PDFs grandes: el original de la clase pesa ~5 MB y sí se versiona;
# cualquier otro PDF de más de 10 MB queda fuera.
data/raw/*.pdf
!data/raw/BASE-ESTANDAR-ILO-SEACE-OCR.pdf

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# SECRETOS. Nada de esto se versiona nunca.
#
# Una clave de API subida a un repositorio publico queda en el historial de git
# para siempre, y los bots que rastrean GitHub la encuentran en minutos. Borrarla
# en un commit posterior NO la saca del historial: hay que revocarla.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
secrets.*

# Salidas que los notebooks escriben al lado de si mismos
notebooks/procesadas/
notebooks/salidas/
notebooks/data/
